import { AppError } from "../../../shared/errors/AppError";
import { CreateStudentInput } from "../inputs/CreateStudent.input";
import { StudentRepository } from "../repository/StudentRepository";
import bcrypt from "bcrypt";

type ResponseResultStudent = {
  id: string;
  cpf: string;
  name: string;
  email: string;
  birthDate: string;
  // RF03: one or more phone numbers are required at sign-up
  phones: string[];
};

export class StudentService {
  constructor(private repository: StudentRepository) {}

  private async hashPassword(password: string) {
    return bcrypt.hash(password, 12);
  }

  async createService(
    dataStudent: CreateStudentInput,
  ): Promise<ResponseResultStudent> {
    const existingEmail = await this.repository.findByEmail(dataStudent.email);

    if (existingEmail) {
      throw new AppError("Email Already Use.", 409);
    }

    const existingCpf = await this.repository.findByCpf(dataStudent.cpf);
    if (existingCpf) {
      throw new AppError("CPF already in use", 409);
    }

    const passwordHashed = await this.hashPassword(dataStudent.password);

    const student = await this.repository.create({
      cpf: dataStudent.cpf,
      name: dataStudent.name,
      email: dataStudent.email,
      password: passwordHashed,
      birthDate: dataStudent.birthDate,
      phones: dataStudent.phones,
      privacyAcceptedAt: dataStudent.privacyAcceptedAt,
      termsAcceptedAt: dataStudent.termsAcceptedAt,
    });

    return {
      id: student.id,
      email: student.email,
      cpf: student.cpf,
      name: student.email,
      birthDate: student.birthDate,
      phones: student.phones.map((p) => p.number),
    };
  }
}
</file>

<file path="src/modules/student/validators/CreateStudentValidator.ts">
import { z } from "zod";

// ============================================================================
// Schemas primitivos reutilizáveis (Create + Update)
// ============================================================================

// RN06 / RNF03: CPF como 11 dígitos, sem pontuação
export const cpfSchema = z
  .string()
  .trim()
  .regex(/^\d{11}$/, "CPF must contain exactly 11 digits, no punctuation");

// RN06: email único, formato válido
export const emailSchema = z.email();

export const nameSchema = z
  .string()
  .trim()
  .min(3, "Name must have at least 3 characters")
  .max(150, "Name must be at most 150 characters");

// RNF01: senha mínima; o hash (bcrypt cost 12) acontece no service
export const passwordSchema = z
  .string()
  .min(8, "Password must have at least 8 characters")
  .max(72, "Password must be at most 72 characters") // limite do bcrypt
  .regex(/[A-Z]/, "Password must contain at least one uppercase letter")
  .regex(/[a-z]/, "Password must contain at least one lowercase letter")
  .regex(/[0-9]/, "Password must contain at least one number");

// birthDate é `type: "date"` na entity → string "YYYY-MM-DD"
export const birthDateSchema = z
  .string()
  .regex(/^\d{4}-\d{2}-\d{2}$/, "birthDate must be in YYYY-MM-DD format")
  .refine(
    (value) => {
      const date = new Date(`${value}T00:00:00Z`);
      return (
        !Number.isNaN(date.getTime()) && date.toISOString().startsWith(value)
      );
    },
    { message: "birthDate is not a valid calendar date" },
  )
  .refine(
    (value) => {
      const date = new Date(`${value}T00:00:00Z`);
      return date.getTime() <= Date.now();
    },
    { message: "birthDate cannot be in the future" },
  );

// RF03: pelo menos 1 telefone (multivalued attribute)
export const phoneSchema = z
  .string()
  .trim()
  .regex(/^\d{10,11}$/, "Phone must contain 10 or 11 digits, no punctuation");

export const phonesSchema = z
  .array(phoneSchema)
  .min(1, "At least one phone number is required")
  .max(5, "At most 5 phone numbers are allowed")
  .refine((phones) => new Set(phones).size === phones.length, {
    message: "Duplicate phone numbers are not allowed",
  });

// ============================================================================
// Schemas de perfil profissional (RF04) — opcionais, usados no Update
// ============================================================================

export const urlSchema = z
  .url("Must be a valid URL")
  .max(255, "URL must be at most 255 characters")
  .nullable();

export const bioSchema = z
  .string()
  .trim()
  .max(1000, "Bio must be at most 1000 characters")
  .nullable();

// "2027-07"
export const expectedGraduationSchema = z
  .string()
  .regex(/^\d{4}-(0[1-9]|1[0-2])$/, "expectedGraduation must be YYYY-MM")
  .refine(
    (value) => {
      const [year, month] = value.split("-").map(Number);
      const end = new Date(Date.UTC(year, month, 0));
      return end.getTime() >= Date.now();
    },
    { message: "expectedGraduation cannot be in the past" },
  )
  .nullable();

export const currentSemesterSchema = z
  .number()
  .int("currentSemester must be an integer")
  .min(1, "currentSemester must be at least 1")
  .max(20, "currentSemester must be at most 20")
  .nullable();

export const institutionSchema = z
  .string()
  .trim()
  .min(2, "institution must have at least 2 characters")
  .max(150, "institution must be at most 150 characters")
  .nullable();

// ============================================================================
// Consentimentos LGPD (RF03 / RNF03)
// ============================================================================

export const termsAcceptedAtSchema = z.coerce.date({
  error: "termsAcceptedAt must be a valid date",
});

export const privacyAcceptedAtSchema = z.coerce.date({
  error: "privacyAcceptedAt must be a valid date",
});

// ============================================================================
// RF03 — Cadastro de estudante
// ============================================================================

export const createStudentSchema = z
  .object({
    cpf: cpfSchema,
    name: nameSchema,
    email: emailSchema,
    password: passwordSchema,
    birthDate: birthDateSchema,
    phones: phonesSchema,
    termsAcceptedAt: termsAcceptedAtSchema,
    privacyAcceptedAt: privacyAcceptedAtSchema,
  })
  .strict(); // rejeita campos desconhecidos

export type CreateStudentInput = z.infer<typeof createStudentSchema>;
</file>

<file path="src/modules/student/validators/UpdateStudentValidator.ts">
import { z } from "zod";
import {
  nameSchema,
  emailSchema,
  passwordSchema,
  phonesSchema,
  urlSchema,
  bioSchema,
  expectedGraduationSchema,
  currentSemesterSchema,
  institutionSchema,
} from "./CreateStudentValidator";
import { LanguageLevel } from "../schema/StudentLanguage.schema";

// ============================================================================
// Sub-schemas de idiomas (RF04)
// ============================================================================

// nível (uma string do enum)
const languageLevelSchema = z.enum(LanguageLevel, {
  error: "Invalid language level",
});

// um idioma (objeto)
const languageSchema = z
  .object({
    name: z.string().trim().min(2).max(50),
    level: languageLevelSchema,
  })
  .strict();

// lista de idiomas (array de objetos)
const languagesSchema = z
  .array(languageSchema)
  .max(10)
  .refine(
    (list) =>
      new Set(list.map((l) => l.name.trim().toLowerCase())).size ===
      list.length,
    { message: "Duplicate languages are not allowed" },
  );
// ============================================================================
// Sub-schemas de experiências (RF04)
// ============================================================================

const experienceSchema = z
  .object({
    company: z
      .string()
      .trim()
      .min(2, "Company must have at least 2 characters")
      .max(150, "Company must be at most 150 characters"),

    role: z
      .string()
      .trim()
      .min(2, "Role must have at least 2 characters")
      .max(100, "Role must be at most 100 characters"),

    startDate: z
      .string()
      .regex(/^\d{4}-\d{2}-\d{2}$/, "startDate must be YYYY-MM-DD"),

    // null = experiência atual (sem data de fim)
    endDate: z
      .string()
      .regex(/^\d{4}-\d{2}-\d{2}$/, "endDate must be YYYY-MM-DD")
      .nullable(),

    description: z
      .string()
      .trim()
      .max(2000, "Description must be at most 2000 characters")
      .nullable(),
  })
  .strict()
  .refine((data) => !data.endDate || data.endDate >= data.startDate, {
    message: "endDate cannot be before startDate",
    path: ["endDate"],
  })
  .refine((data) => data.startDate <= new Date().toISOString().slice(0, 10), {
    message: "startDate cannot be in the future",
    path: ["startDate"],
  });

const experiencesSchema = z
  .array(experienceSchema)
  .max(20, "At most 20 experiences are allowed");

// ============================================================================
// RF04 — Edição de perfil (PATCH parcial)
// ============================================================================
//
// Fora do escopo deste schema, de propósito:
//   - cpf: correção só via administrador (updateCpf / RF04)
//   - termsAcceptedAt / privacyAcceptedAt: consentimento só no cadastro
//
// Semântica de PATCH:
//   - campo ausente        → undefined → não altera
//   - campo = null         → limpa o valor (para os nullable)
//   - campo = valor        → atualiza

export const updateStudentSchema = z
  .object({
    // --- Campos básicos ---
    name: nameSchema.optional(),
    email: emailSchema.optional(),
    phones: phonesSchema.optional(),

    // --- Perfil profissional ---
    bio: bioSchema.optional(),
    linkedinUrl: urlSchema.optional(),
    portfolioUrl: urlSchema.optional(),
    expectedGraduation: expectedGraduationSchema.optional(),
    currentSemester: currentSemesterSchema.optional(),
    institution: institutionSchema.optional(),

    // --- Listas multivaloradas ---
    languages: languagesSchema.optional(),
    experiences: experiencesSchema.optional(),
  })
  .strict()
  .refine((data) => Object.keys(data).length > 0, {
    message: "At least one field must be provided",
  });

export type UpdateStudentInput = z.infer<typeof updateStudentSchema>;
</file>

