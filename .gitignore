# ============================================================================
# Uploads / arquivos enviados
# ============================================================================
# Se um dia o upload de currículo (RNF11) cair no filesystem local,
# esses diretórios não devem ir pro Git.
uploads/
storage/
public/uploads/
private/uploads/

# ============================================================================
# TypeORM
# ============================================================================
# Migrations geradas automaticamente não entram.
# Só migrations escritas à mão (versionadas) devem ser commitadas.
# Descomente se você gerar migrations a partir das entities e não quiser versioná-las.
# src/migrations/*.ts

# ============================================================================
# Pacotes / artefatos
# ============================================================================
*.tgz
*.tar.gz