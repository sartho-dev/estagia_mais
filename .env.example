# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=estagia_mais


JWT_SECRET=your-secret-key-here
SESSION_IDLE_MS=1800000
SESSION_MAX_AGE_MS=7200000
TOUCH_THROTTLE_MS=60000
BCRYPT_COST=12

# Application Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Refresh Token Cleanup
REFRESH_TOKEN_CLEANUP_INTERVAL_MINUTES=60

# Sentry (Optional)
SENTRY_DSN=

# Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Docker/Cloud Configuration
TRUST_PROXY_HOPS=1
